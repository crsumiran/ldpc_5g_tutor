OPENROUTER_API_KEY=
TUTOR_ENGINE=opencode
OPENCODE_TIMEOUT_SECONDS=180
PROJECT_ROOT=/absolute/path/to/ldpc_5g_tutor
TUTOR_MODEL=google/gemma-4-31b-it:free
TUTOR_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,cohere/north-mini-code:free,qwen/qwen3.8-27b:free
